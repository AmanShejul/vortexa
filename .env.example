# Supabase configuration
# Copy this file to .env.local and fill in the values for your project.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_LOCAL_PYTHON_TIMEOUT_MS=10000

# Optional Judge0-compatible execution service for genuine Run Code / Submit Mission execution.
# The arena defaults to local Pyodide execution; Judge0 remains an optional trusted server mode.
# Set this to the base URL from your Judge0 provider; the app appends /submissions.
# Obtain the endpoint and credentials from your chosen hosted provider, or your
# self-hosted Judge0 deployment. Do not use this placeholder as a real endpoint.
JUDGE0_API_URL=https://your-judge0-provider.example
# Optional for endpoints that do not require authentication.
JUDGE0_API_KEY=your-judge0-key
# Defaults match Judge0 CE's X-Auth-Token header and Python 3.8.1 language ID.
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_PREFIX=
JUDGE0_PYTHON_LANGUAGE_ID=71

# Optional; use the same random value (at least 32 bytes) across production instances.
# Without it, a process-local random key is used and evidence expires on process restart.
MENTOR_EVIDENCE_SECRET=
